[server]
host = "127.0.0.1"
port = 6401
database_path = "./delta.db"
rate_limit_per_minute = 10
db_pool_size = 8
max_concurrent_uploads = 16
log_level = "info"
cleanup_interval_minutes = 30

# QUIC/HTTP3 UDP port. Defaults to `port + 1` (6402) when unset.
# quic_port = 6402

[urls]
public_base_url = "http://localhost:6402"
juicehost_url = "http://127.0.0.1:6402"

# Single link domain (Cloudflare Worker router). When set, share links for
# official regional hosts are minted under this host instead of the region,
# e.g. https://f.juicey.dev/v/abc123.gif. Custom third-party hosts keep theirs.
# Env override: ROUTER_BASE_URL
# router_base_url = "https://f.juicey.dev"

# Public juicehost URL handed to browsers. Defaults to public_base_url.
# public_juicehost_url = "http://localhost:6402"

# Origin string for this juiceback. Defaults to "http://{host}:{port}".
# juiceback_origin = "http://127.0.0.1:6401"

[cors]
# Protected unlock shells run on the storage host and POST passwords/keys
# directly here, so every host public origin must be listed (browser CORS),
# e.g. origins = ["http://localhost:6400", "http://localhost:6402", "https://files.example.com"]
origins = ["http://localhost:6400", "http://localhost:6402", "http://127.0.0.1:6402"]

[report]
retention_days = 90
feedback_retention_days = 90

# Report webhook URL.
# webhook_url = "https://example.com/hook"

# SMTP relay for report mails. check env for pass
# smtp_host = "mail.example.com"
smtp_port = 465
# smtp_username = "juicebox"
# email_recipient = "abuse@example.com"
# email_sender = "juicebox@example.com"

[cloudflare]
# Cloudflare zone for cache purges. (check env for api)
# zone_id = "12345600006767"

[cobalt]
enabled = false
api_url = "http://localhost:7272"
fetch_empty_retry_delay_secs = 10

# Session API URL (check env for api)
# session_api_url = "http://localhost:7272"

[dte]
enabled = false
assumed_bps = 2097152.0
safety_mult = 2.0
base_overhead_secs = 120
min_ttl_secs = 600
max_ttl_secs = 21600
mint_limit = 60
mint_window_secs = 600
mint_burst = 15

[features]
# WARNING!!!! plain-HTTP local dev needs secure_cookies = false,
# Secure cookies are never sent back over http.
secure_cookies = true
direct_upload_enabled = false

[regions]
# Per-region public juicehost map. TOML-only.
# [regions.public_juicehosts]
# eu = "http://localhost:6402"

[r2]
# Hot-tier overflow for popular files. Disabled by default; enable with
# enabled = true plus bucket/endpoint/public_base_url and R2_* env keys.
# Usage is capped by max_bytes/max_hot_files: promotions stop when full,
# so the R2 bill stays bounded. Expiry/deletion removes the R2 copy.
enabled = false
# bucket = "juicebox-hot"
# endpoint = "https://<account-id>.r2.cloudflarestorage.com"
# public_base_url = "https://r.juicey.dev"
max_bytes = 10737418240
max_hot_files = 500
max_promote_bytes = 268435456

[promo]
# Velocity promoter. Only runs when [r2].enabled. dry_run = true only logs
# candidates so thresholds can be tuned before spending anything.
interval_secs = 300
min_views = 50
min_views_per_min = 10.0
min_ttl_remaining_secs = 3600
dry_run = true

[sentry]
# DSN is env-only: SENTRY_DSN (or SENTRY_DSN_JUICEBACK).
environment = "production"
