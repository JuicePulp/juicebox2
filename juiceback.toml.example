[server]
host = "127.0.0.1"
port = 6401
database_path = "./delta.db"
rate_limit_per_minute = 10
db_pool_size = 8
max_concurrent_uploads = 16
log_level = "info"
cleanup_interval_minutes = 30

# QUIC/HTTP3 UDP port. Defaults to `port + 1` (6402) when unset.
# quic_port = 6402

[urls]
public_base_url = "http://localhost:6402"
juicehost_url = "http://127.0.0.1:6402"

# Public juicehost URL handed to browsers. Defaults to public_base_url.
# public_juicehost_url = "http://localhost:6402"

# Origin string for this juiceback. Defaults to "http://{host}:{port}".
# juiceback_origin = "http://127.0.0.1:6401"

[cors]
origins = ["http://localhost:6400"]

[report]
retention_days = 90
feedback_retention_days = 90

# Report webhook URL.
# webhook_url = "https://example.com/hook"

# SMTP relay for report mails. check env for pass
# smtp_host = "mail.example.com"
smtp_port = 465
# smtp_username = "juicebox"
# email_recipient = "abuse@example.com"
# email_sender = "juicebox@example.com"

[cloudflare]
# Cloudflare zone for cache purges. (check env for api)
# zone_id = "12345600006767"

[cobalt]
enabled = false
api_url = "http://localhost:7272"
fetch_empty_retry_delay_secs = 10

# Session API URL (check env for api)
# session_api_url = "http://localhost:7272"

[dte]
enabled = false
assumed_bps = 2097152.0
safety_mult = 2.0
base_overhead_secs = 120
min_ttl_secs = 600
max_ttl_secs = 21600
mint_limit = 60
mint_window_secs = 600
mint_burst = 15

[features]
# WARNING!!!! plain-HTTP local dev needs secure_cookies = false,
# Secure cookies are never sent back over http.
secure_cookies = true
direct_upload_enabled = false

[regions]
# Per-region public juicehost map. TOML-only.
# [regions.public_juicehosts]
# eu = "http://localhost:6402"

[sentry]
# DSN is env-only: SENTRY_DSN (or SENTRY_DSN_JUICEBACK).
environment = "production"
