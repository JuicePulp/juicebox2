[public]
host = "127.0.0.1"
port = 6402

[quic]
# host = "127.0.0.1"
# port = 6403
cert_path = "./quic-cert.der"
max_connections = 256
max_requests = 256
handshake_seconds = 10
idle_seconds = 30
request_total_seconds = 600

[threads]
worker_threads = 3

[dirs]
files_dir = "./files"
# backend_url = "http://127.0.0.1:6401"
# frontend_url = "http://localhost:6400"

[security]
# File-type blocking strictness, least to most: none, low, medium, high.
danger_level = "medium"
# allowed_origins = ["http://localhost:6400"]
# Trusted proxy CIDRs for client-IP extraction. Unset = none.
# trusted_proxy_cidrs = "127.0.0.1/32"

# this is dangerous, refrain from using this UNLESS you want an all public instance
allow_no_auth = false
# u gotta set the JUICEHOST_API_KEY

[s3]
# bucket = "juicebox-files"
# region = "us-east-1"
# endpoint = "https://s3.example.com"
allow_http = false

[r2]
# Hot-tier overflow (e.g. Cloudflare R2) for popular files. Promoted copies
# are written here by juiceback's velocity / embed promoters; hot bytes are
# served from R2 under the existing /f/ + /d/ + /c/ URLs (no public /hot/
# endpoint — the bucket can stay private). All unset = hot-tier disabled.
# bucket = "juicebox-hot"
# endpoint = "https://<account-id>.r2.cloudflarestorage.com"
# region = "auto"
# R2 credentials. Env-only, no TOML keys: R2_ACCESS_KEY / R2_SECRET_KEY

[limits]
min_free_space_gb = 5
max_file_size_mb = 500
max_range_response_mb = 16
max_concurrent_uploads = 16
max_concurrent_downloads = 64
max_concat_parts = 128
tcp_body_inactivity_seconds = 30
tcp_request_total_seconds = 600
tcp_max_concurrent_requests = 512

[features]
quick_link = true
custom_id = true
# Edge cache for /f/ + /d/ bytes (Cloudflare in front). Responses carry
# `public, max-age=min(ttl_remaining, max_age), s-maxage=..., immutable`
# (bytes are immutable by ID) plus `cache-tag: juicebox:{id}`.
# Cache /f/* + /d/* at the edge, bypass /v/* + /api/* + /file/*.
# Default off: responses are `no-store`.
file_cache_enabled = false
file_cache_max_age_secs = 86400
default_ttl_hours = 24.0
allowed_ttl_hours = [0.5, 1.0, 6.0, 12.0, 24.0, 72.0, 168.0]

[ban]
# Static ban list loaded once at startup. Runtime updates are pushed by juiceback.
# list_file = "./bans.txt"

[sentry]
environment = "production"
