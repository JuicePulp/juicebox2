[public]
host = "127.0.0.1"
port = 6402

[quic]
# host = "127.0.0.1"
# port = 6403
cert_path = "./quic-cert.der"
max_connections = 256
max_requests = 256
handshake_seconds = 10
idle_seconds = 30
request_total_seconds = 600

[threads]
worker_threads = 3

[dirs]
files_dir = "./files"
# backend_url = "http://127.0.0.1:6401"
# frontend_url = "http://localhost:6400"

[security]
# File-type blocking strictness, least to most: none, low, medium, high.
danger_level = "medium"
# allowed_origins = ["http://localhost:6400"]
# Trusted proxy CIDRs for client-IP extraction. Unset = none.
# trusted_proxy_cidrs = "127.0.0.1/32"

# this is dangerous, refrain from using this UNLESS you want an all public instance
allow_no_auth = false
# u gotta set the JUICEHOST_API_KEY

[s3]
# bucket = "juicebox-files"
# region = "us-east-1"
# endpoint = "https://s3.example.com"
allow_http = false

[limits]
min_free_space_gb = 5
max_file_size_mb = 500
max_range_response_mb = 16
max_concurrent_uploads = 16
max_concurrent_downloads = 64
max_concat_parts = 128
tcp_body_inactivity_seconds = 30
tcp_request_total_seconds = 600
tcp_max_concurrent_requests = 512

[features]
quick_link = true
custom_id = true
file_cache_enabled = false
file_cache_max_age_secs = 3600
default_ttl_hours = 24.0
allowed_ttl_hours = [0.5, 1.0, 6.0, 12.0, 24.0, 72.0, 168.0]

[ban]
# list_file = "./bans.txt"
# sync_url = "https://example.com/bans.txt"
sync_interval_secs = 30

[sentry]
environment = "production"
