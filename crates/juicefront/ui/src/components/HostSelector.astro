---

import { iconSvgHtml } from "../lib/icons";
import { readCookieHost } from "../lib/server-host";
import { getOfficialNodes, getUnofficialNodes, type HostNode } from "../lib/hosts";
import { resolveLocale, t } from "../i18n";
import pkg from "../../package.json";

const currentLocale = resolveLocale(Astro.currentLocale);
const localePrefix = currentLocale === "en" ? "" : `/${currentLocale}`;
const feedbackHref = `${localePrefix}/feedback`;

const official = getOfficialNodes();
const unofficial = getUnofficialNodes();
const savedHost = readCookieHost(Astro.request.headers.get("cookie")) || "";

const renderRow = (n: HostNode) => (
  <tr
    class="hostsel-row"
    tabindex="0"
    data-hostsel-row=""
    data-url={n.url}
    data-name={n.name}
    data-region={n.region}
    data-official={n.official ? "true" : "false"}
    data-selected={n.url === savedHost ? "" : undefined}
  >
    <td class="hostsel-cell hostsel-cell--dot">
      <span class="hostsel-dot" data-hostsel-dot="" data-state="unknown" aria-hidden="true"></span>
    </td>
    <td class="hostsel-cell hostsel-cell--meta">
      <span class="hostsel-name">{n.name}</span>
      <span class="hostsel-url">{n.url}</span>
    </td>
    <td class="hostsel-cell hostsel-cell--caps"><span class="hostsel-badges" data-hostsel-badges=""></span></td>
    <td class="hostsel-cell hostsel-cell--latency" data-hostsel-latency="">—</td>
  </tr>
);
---

<div
  id="host-selector-modal"
  class="mdloverlay mdl-target"
  role="dialog"
  aria-modal="true"
  aria-labelledby="host-selector-title"
  data-current-version={pkg.version}
  data-str-online={t(currentLocale, "hostsel.online")}
  data-str-offline={t(currentLocale, "hostsel.offline")}
  data-str-checking={t(currentLocale, "hostsel.checking")}
  data-str-ping={t(currentLocale, "hostsel.ping")}
  data-str-pinging={t(currentLocale, "hostsel.pinging")}
  data-str-select={t(currentLocale, "hostsel.select")}
  data-str-selected={t(currentLocale, "hostsel.selected")}
  data-str-applied={t(currentLocale, "hostsel.applied")}
>
  <a href="#!" data-cuelume-close data-cuelume-emphasis="subtle" class="mdl-target__backdrop" aria-label={t(currentLocale, "modal.close")}></a>
  <div class="mdlcontent mdlcontent--wide hostsel">
    <div class="mdlheader">
      <h2 id="host-selector-title" class="mdltitle">
        <span set:html={iconSvgHtml("settings", 24)} class="mdltitle-icon" />
        {t(currentLocale, "hostsel.title")}
      </h2>
      <a href="#!" data-cuelume-close data-cuelume-emphasis="subtle" class="mdlclose" aria-label={t(currentLocale, "modal.close")}>
        <span set:html={iconSvgHtml("close", 24)} />
      </a>
    </div>
    <div class="mdlbody hostsel__body">
      <div class="hostsel-toolbar" role="search">
        <label class="hostsel-sr" for="hostsel-search">{t(currentLocale, "hostsel.search_label")}</label>
        <input
          data-cuelume-type id="hostsel-search"
          type="search"
          class="form-input hostsel-search"
          data-hostsel-search=""
          placeholder={t(currentLocale, "hostsel.search_ph")}
          autocomplete="off"
        />
        <button type="button" data-cuelume-tap data-cuelume-emphasis="subtle" class="mdlbtn mdlbtn--secondary hostsel-refresh" data-hostsel-ping-all="">
          {t(currentLocale, "hostsel.ping_all")}
        </button>
      </div>
      <p class="hostsel-statusline" role="status" data-hostsel-statusline=""></p>

      <section aria-labelledby="hostsel-official-title" data-hostsel-section="">
        <h3 id="hostsel-official-title" class="hostsel__group-title">{t(currentLocale, "hostsel.official")}</h3>
        <table class="hostsel-table">
          <tbody data-hostsel-list="">
            {official.map(renderRow)}
          </tbody>
        </table>
        <p class="hostsel-empty" data-hostsel-empty="" hidden>{t(currentLocale, "hostsel.empty")}</p>
      </section>

      <section aria-labelledby="hostsel-unofficial-title" data-hostsel-section="">
        <h3 id="hostsel-unofficial-title" class="hostsel__group-title">{t(currentLocale, "hostsel.unofficial")}</h3>
        <table class="hostsel-table">
          <tbody data-hostsel-list="">
            {unofficial.map(renderRow)}
          </tbody>
        </table>
        {unofficial.length > 0 ? (
          <p class="hostsel-empty" data-hostsel-empty="" hidden>{t(currentLocale, "hostsel.empty")}</p>
        ) : (
          <p class="hostsel-empty" data-hostsel-empty="">{t(currentLocale, "hostsel.empty_unofficial")}</p>
        )}
      </section>

      <div class="hostsel-add">
        <div class="hostsel-add__text">
          <strong>{t(currentLocale, "hostsel.add_title")}</strong>
          <span>{t(currentLocale, "hostsel.add_desc")}</span>
        </div>
        <a href={feedbackHref} data-cuelume-navigate class="mdlbtn mdlbtn--primary">{t(currentLocale, "hostsel.add_btn")}</a>
      </div>
    </div>
  </div>
</div>

<script>
  import { initHostSelector } from "../lib/host-selector";
  document.addEventListener("astro:page-load", initHostSelector);
  initHostSelector();
</script>

<style>
  .mdlcontent--wide {
    max-width: 560px;
  }
  .hostsel__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
  }
  .hostsel-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .hostsel-toolbar {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .hostsel-search {
    flex: 1;
    min-width: 0;
  }
  .hostsel-refresh {
    flex-shrink: 0;
    padding: 0.35rem 0.7rem;
    font-size: 0.8rem;
  }
  .hostsel-statusline {
    margin: 0;
    font-size: 0.75rem;
    color: var(--juice-400);
  }
  .hostsel-statusline:empty {
    display: none;
  }
  .hostsel__group-title {
    margin: 0.5rem 0 0.15rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--juice-400);
  }
  .hostsel-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .hostsel-row {
    border-top: 1px solid var(--juice-700);
    cursor: pointer;
  }
  .hostsel-row:last-child {
    border-bottom: 1px solid var(--juice-700);
  }
  .hostsel-row:hover {
    background-color: var(--juice-800);
  }
  .hostsel-row:focus-visible {
    outline: 2px solid var(--orange-500);
    outline-offset: -2px;
  }
  .hostsel-row[data-selected] {
    background-color: var(--juice-800);
  }
  .hostsel-cell {
    padding: 0.4rem 0.5rem;
    vertical-align: middle;
  }
  .hostsel-cell--dot {
    width: 1.1rem;
    padding-right: 0;
  }
  .hostsel-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background-color: var(--juice-600);
  }
  .hostsel-dot[data-state="checking"] {
    background-color: var(--orange-400);
  }
  .hostsel-dot[data-state="online"] {
    background-color: var(--green-500);
  }
  .hostsel-dot[data-state="offline"] {
    background-color: var(--red-500);
  }
  .hostsel-cell--meta {
    min-width: 0;
  }
  .hostsel-name {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--juice-100);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hostsel-url {
    display: block;
    font-size: 0.75rem;
    color: var(--juice-400);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hostsel-url:empty {
    display: none;
  }
  .hostsel-badges {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.1rem;
  }
  .hostsel-badges:empty {
    display: none;
  }
  .hostsel-cell--caps {
    width: 34%;
  }
  .hostsel-cell--caps .hostsel-badges {
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .hostsel-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background-color: var(--juice-700);
    color: var(--juice-200);
    white-space: nowrap;
  }
  .hostsel-badge--legacy {
    background-color: transparent;
    border: 1px dashed var(--orange-400);
    color: var(--orange-400);
  }
  .hostsel-cell--latency {
    width: 4.5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    color: var(--juice-200);
    white-space: nowrap;
  }
  .hostsel-empty {
    margin: 0.25rem 0;
    font-size: 0.8rem;
    color: var(--juice-400);
  }
  .hostsel-add {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    margin-top: 0.25rem;
    padding: 0.6rem 0.75rem;
    background-color: var(--juice-800);
    border: 1px dashed var(--juice-600);
    border-radius: 0.5rem;
  }
  .hostsel-add__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.85rem;
    color: var(--juice-300);
  }
  .hostsel-add__text strong {
    color: var(--juice-100);
  }
</style>
