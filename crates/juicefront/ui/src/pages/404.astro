---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRepoUrl } from "../lib/metadata";
import { t, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const canonicalUrl = getRepoUrl();
---

<BaseLayout
    title={t(locale, "not_found.title")}
    description={t(locale, "not_found.description")}
    canonical={canonicalUrl}
    bodyClass="content-page"
>
    <main id="main-content" transition:animate="none">
        <h1>{t(locale, "not_found.heading")}</h1>
    </main>
</BaseLayout>
